---
const {
  title = "Top Stories For You",
  page = "home",
  lead = "Live news stream tailored by your reading behavior."
} = Astro.props;

const navItems = [
  { key: "home", href: "/", label: "Home" },
  { key: "me", href: "/insights", label: "My Feed" }
];

const channelItems = [
  { key: "top", label: "Top" },
  { key: "politics", label: "Politics" },
  { key: "business", label: "Business" },
  { key: "technology", label: "Technology" },
  { key: "sports", label: "Sports" },
  { key: "culture", label: "Culture" },
  { key: "lifestyle", label: "Lifestyle" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-page={page}>
    <header class="topline">
      <div class="inner topline-inner">
        <div class="topline-left">
          <strong>LIVE</strong>
          <span>Personalized coverage powered by real-time feeds.</span>
        </div>
        <span class="topline-right">Built for Everyday Readers</span>
      </div>
    </header>

    <header class="masthead">
      <div class="inner masthead-inner">
        <a href="/" class="brand">
          <b>DailyPulse</b>
          <small>Your Personal Newswire</small>
        </a>
        <div class="masthead-actions">
          <nav aria-label="Primary">
            {
              navItems.map((item) => (
                <a href={item.href} class={item.key === page ? "active" : ""}>{item.label}</a>
              ))
            }
          </nav>
          <form class="global-search" role="search" autocomplete="off">
            <button class="search-toggle" type="button" aria-label="Search stories">
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path
                  d="M13.7 12.3h-.74l-.26-.25a5.97 5.97 0 1 0-.64.64l.25.26v.74L17 18.3 18.3 17l-4.6-4.7zM8.5 13A4.5 4.5 0 1 1 13 8.5 4.5 4.5 0 0 1 8.5 13z"
                ></path>
              </svg>
            </button>
            <input
              class="search-input"
              type="search"
              name="q"
              placeholder="Search stories..."
              spellcheck="false"
              autocomplete="off"
            />
          </form>
        </div>
      </div>
      <div class="channel-row">
        <div class="inner channel-list">
          {
            channelItems.map((item) => (
              <a class="channel-link" data-topic={item.key} href={`/?topic=${item.key}`}>
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <main class="inner page-shell">
      <slot />
    </main>
    <script is:inline>
      (() => {
        const links = [...document.querySelectorAll(".channel-link[data-topic]")];
        const highlightChannel = () => {
          if (!links.length) {
            return;
          }
          const topic = (new URLSearchParams(window.location.search).get("topic") || "top").toLowerCase();
          let matched = false;
          links.forEach((link) => {
            const active = link.dataset.topic === topic;
            link.classList.toggle("active", active);
            matched = matched || active;
          });
          if (!matched) {
            links[0].classList.add("active");
          }
        };

        highlightChannel();
        window.addEventListener("popstate", highlightChannel);

        const search = document.querySelector(".global-search");
        if (!search) {
          return;
        }
        const toggle = search.querySelector(".search-toggle");
        const input = search.querySelector(".search-input");
        if (!toggle || !input) {
          return;
        }

        const setOpen = (open) => {
          search.classList.toggle("open", open);
        };

        const syncSearchFromUrl = () => {
          const currentQuery = (new URLSearchParams(window.location.search).get("q") || "").trim();
          input.value = currentQuery;
          setOpen(Boolean(currentQuery));
        };

        syncSearchFromUrl();
        window.addEventListener("popstate", syncSearchFromUrl);

        const applySearch = () => {
          const query = input.value.trim();
          const currentParams = new URLSearchParams(window.location.search);
          const nextParams = new URLSearchParams();
          const currentTopic = (currentParams.get("topic") || "").trim();
          if (currentTopic) {
            nextParams.set("topic", currentTopic);
          }
          if (query) {
            nextParams.set("q", query);
          }

          const next = `/` + (nextParams.toString() ? `?${nextParams.toString()}` : "");
          const current = `${window.location.pathname}${window.location.search}`;
          if (current === next) {
            window.location.reload();
            return;
          }
          window.location.assign(next);
        };

        toggle.addEventListener("click", () => {
          if (!search.classList.contains("open")) {
            setOpen(true);
            input.focus();
            input.select();
            return;
          }
          applySearch();
        });

        search.addEventListener("submit", (event) => {
          event.preventDefault();
          applySearch();
        });

        input.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            if (!input.value.trim()) {
              setOpen(false);
            }
            input.blur();
          }
        });

        input.addEventListener("blur", () => {
          if (!input.value.trim()) {
            setOpen(false);
          }
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f3f4f6;
    --card: #ffffff;
    --card-2: #f8fafc;
    --line: #e4e7ed;
    --ink: #1f2329;
    --muted: #6b7280;
    --brand: #f04142;
    --brand-deep: #d9363e;
    --accent: #f04142;
    --tag-bg: #fff1f1;
    --tag-line: #ffd7d9;
    --tag-ink: #ad2a36;
    --shadow: 0 6px 20px rgba(15, 23, 42, 0.06);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-family: "Noto Sans", "Segoe UI", sans-serif;
  }

  .inner {
    width: min(1160px, 100%);
    margin: 0 auto;
    padding: 0 1rem;
  }

  .topline {
    background: #151922;
    color: #fff;
    font-size: 0.76rem;
  }

  .topline-inner {
    min-height: 34px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .topline-left {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .topline-right {
    color: #d0d5dd;
  }

  .topline strong {
    letter-spacing: 0.08em;
    font-size: 0.74rem;
    color: #ff6669;
  }

  .masthead {
    position: sticky;
    top: 0;
    z-index: 10;
    background: #fff;
    border-bottom: 1px solid var(--line);
  }

  .masthead-inner {
    min-height: 74px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .masthead-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand {
    text-decoration: none;
    color: inherit;
    display: grid;
    gap: 0.04rem;
  }

  .brand b {
    font-size: 2rem;
    color: var(--brand);
    font-family: "Source Serif 4", serif;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .brand small {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #667085;
  }

  nav {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  nav a {
    text-decoration: none;
    color: #475467;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.42rem 0.72rem;
    border-radius: 6px;
    transition: background 130ms ease, color 130ms ease;
  }

  nav a:hover {
    background: #f3f4f6;
    color: var(--ink);
  }

  nav a.active {
    background: var(--brand);
    color: #fff;
  }

  .global-search {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid #d7deea;
    border-radius: 999px;
    background: #fff;
    padding: 0.2rem;
    transition: box-shadow 160ms ease, border-color 160ms ease;
  }

  .global-search:hover,
  .global-search:focus-within {
    border-color: #c7d1e0;
    box-shadow: 0 0 0 3px rgba(240, 65, 66, 0.08);
  }

  .search-toggle {
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 999px;
    background: #fff;
    color: #475467;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .search-toggle svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .search-input {
    width: 0;
    opacity: 0;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--ink);
    background: transparent;
    transition: width 220ms ease, opacity 160ms ease;
  }

  .global-search.open .search-input {
    width: min(34vw, 18rem);
    opacity: 1;
    padding-right: 0.45rem;
  }

  .search-input:focus {
    outline: none;
  }

  .channel-row {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: #fafafa;
  }

  .channel-list {
    min-height: 42px;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    overflow-x: auto;
    white-space: nowrap;
    font-size: 0.8rem;
    color: #344054;
    font-weight: 600;
  }

  .channel-link {
    position: relative;
    z-index: 0;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    padding: 0.2rem 0.05rem;
    transition: color 150ms ease;
  }

  .channel-link::before {
    content: "";
    position: absolute;
    left: -0.48rem;
    right: -0.48rem;
    top: -0.14rem;
    bottom: -0.14rem;
    border-radius: 999px;
    background: rgba(240, 65, 66, 0.08);
    opacity: 0;
    transform: scale(0.88);
    transition: opacity 180ms ease, transform 180ms ease;
    z-index: -1;
  }

  .channel-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.48rem;
    height: 2px;
    border-radius: 2px;
    background: var(--brand);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 210ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .channel-link:hover {
    color: var(--brand);
  }

  .channel-link:hover::before {
    opacity: 0.55;
    transform: scale(1);
  }

  .channel-link.active {
    color: var(--brand);
  }

  .channel-link.active::before {
    opacity: 1;
    transform: scale(1);
  }

  .channel-link.active::after {
    transform: scaleX(1);
  }

  .page-shell {
    padding-top: 0.95rem;
    padding-bottom: 1.5rem;
    animation: page-in 260ms ease both;
  }

  .panel {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
    box-shadow: var(--shadow);
    padding: 0.95rem;
  }

  .panel + .panel {
    margin-top: 0.85rem;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--tag-line);
    background: var(--tag-bg);
    color: var(--tag-ink);
    font-size: 0.72rem;
    border-radius: 999px;
    padding: 0.18rem 0.48rem;
  }

  .message {
    margin: 0;
    padding: 0.52rem 0.66rem;
    border-radius: 8px;
    font-size: 0.82rem;
    border: 1px solid transparent;
  }

  .message.ok {
    background: #ecfdf3;
    color: #106a44;
    border-color: #c8edd7;
  }

  .message.error {
    background: #fef2f2;
    color: #b42318;
    border-color: #fcd3d5;
  }

  .muted {
    color: var(--muted);
  }

  @keyframes page-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 760px) {
    .masthead-inner {
      min-height: 64px;
    }

    .topline-inner {
      min-height: 32px;
    }

    .topline-right {
      display: none;
    }

    .brand b {
      font-size: 1.65rem;
    }

    .masthead-actions {
      gap: 0.35rem;
    }

    .global-search.open .search-input {
      width: min(46vw, 12.5rem);
    }
  }
</style>
