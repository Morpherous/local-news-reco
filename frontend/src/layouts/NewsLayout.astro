---
const {
  title = "Top Stories For You",
  page = "home",
  lead = "Live news stream tailored by your reading behavior."
} = Astro.props;

const navItems = [
  { key: "home", href: "/", label: "Home" },
  { key: "me", href: "/insights", label: "My Feed" }
];

const channelItems = [
  { key: "top", label: "Top" },
  { key: "politics", label: "Politics" },
  { key: "business", label: "Business" },
  { key: "technology", label: "Technology" },
  { key: "sports", label: "Sports" },
  { key: "culture", label: "Culture" },
  { key: "lifestyle", label: "Lifestyle" }
];

const utilityLinks = [
  { label: "Download App", href: "#" },
  { label: "About", href: "#" },
  { label: "Feedback", href: "#" },
  { label: "Support", href: "#" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;700;800&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-page={page}>
    <header class="hero-header">
      <div class="utility-row">
        <div class="inner utility-inner">
          <div class="utility-links">
            {
              utilityLinks.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))
            }
          </div>
          <div class="utility-right">
            <span class="utility-weather" data-weather hidden></span>
            <nav class="utility-nav" aria-label="Primary">
              {
                navItems.map((item) => (
                  <a href={item.href} class={item.key === page ? "active" : ""}>{item.label}</a>
                ))
              }
            </nav>
            <a class="utility-login" href="/insights">Log In</a>
          </div>
        </div>
      </div>

      <div class="hero-core">
        <div class="inner hero-inner">
          <a href="/" class="hero-brand" aria-label="DailyPulse Home">
            <strong>DailyPulse</strong>
            <small>Realtime Personalized News</small>
          </a>

          <form class="global-search" role="search" autocomplete="off">
            <input
              class="search-input"
              type="search"
              name="q"
              placeholder="Search the latest stories..."
              spellcheck="false"
              autocomplete="off"
            />
            <button class="search-toggle" type="submit" aria-label="Search stories">
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path
                  d="M13.7 12.3h-.74l-.26-.25a5.97 5.97 0 1 0-.64.64l.25.26v.74L17 18.3 18.3 17l-4.6-4.7zM8.5 13A4.5 4.5 0 1 1 13 8.5 4.5 4.5 0 0 1 8.5 13z"
                ></path>
              </svg>
            </button>
          </form>
        </div>
      </div>
    </header>

    <div class="channel-row">
      <div class="inner channel-inner">
        <div class="channel-list">
          {
            channelItems.map((item) => (
              <a class="channel-link" data-topic={item.key} href={`/?topic=${item.key}`}>
                {item.label}
              </a>
            ))
          }
        </div>
        <div class="channel-cta">
          <span>Sign in for deeper recommendations</span>
          <a href="/insights">Open My Feed</a>
        </div>
      </div>
    </div>

    <main class="inner page-shell">
      <slot />
    </main>

    <script is:inline>
      (() => {
        const links = [...document.querySelectorAll(".channel-link[data-topic]")];
        const highlightChannel = () => {
          if (!links.length) {
            return;
          }
          const topic = (new URLSearchParams(window.location.search).get("topic") || "top").toLowerCase();
          let matched = false;
          links.forEach((link) => {
            const active = link.dataset.topic === topic;
            link.classList.toggle("active", active);
            matched = matched || active;
          });
          if (!matched) {
            links[0].classList.add("active");
          }
        };

        highlightChannel();
        window.addEventListener("popstate", highlightChannel);

        const weatherEl = document.querySelector("[data-weather]");
        if (weatherEl) {
          hydrateWeather(weatherEl);
        }

        const search = document.querySelector(".global-search");
        if (!search) {
          return;
        }
        const input = search.querySelector(".search-input");
        if (!input) {
          return;
        }

        const syncSearchFromUrl = () => {
          const query = (new URLSearchParams(window.location.search).get("q") || "").trim();
          input.value = query;
        };

        syncSearchFromUrl();
        window.addEventListener("popstate", syncSearchFromUrl);

        search.addEventListener("submit", (event) => {
          event.preventDefault();
          const query = input.value.trim();
          const currentParams = new URLSearchParams(window.location.search);
          const nextParams = new URLSearchParams();
          const topic = (currentParams.get("topic") || "").trim();
          if (topic) {
            nextParams.set("topic", topic);
          }
          if (query) {
            nextParams.set("q", query);
          }
          const next = `/` + (nextParams.toString() ? `?${nextParams.toString()}` : "");
          const current = `${window.location.pathname}${window.location.search}`;
          if (current === next) {
            window.location.reload();
            return;
          }
          window.location.assign(next);
        });

        async function hydrateWeather(el) {
          try {
            const geo = await fetchJsonWithTimeout("https://ipapi.co/json/");
            const latitude = Number(geo && geo.latitude);
            const longitude = Number(geo && geo.longitude);
            if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) {
              throw new Error("Missing coordinates");
            }

            const city = normalizeText((geo && geo.city) || (geo && geo.region) || "Local");
            const weather = await fetchJsonWithTimeout(
              `https://api.open-meteo.com/v1/forecast?latitude=${encodeURIComponent(latitude)}&longitude=${encodeURIComponent(longitude)}&current=temperature_2m,weather_code&temperature_unit=celsius&timezone=auto`
            );
            const current = weather && weather.current ? weather.current : {};
            const tempRaw = Number(current.temperature_2m);
            const weatherCode = Number(current.weather_code);
            const condition = weatherCodeToLabel(weatherCode);
            const temp = Number.isFinite(tempRaw) ? `${Math.round(tempRaw)}C` : "";
            const pieces = [city, condition, temp].filter(Boolean);

            if (!pieces.length) {
              throw new Error("No weather payload");
            }
            el.textContent = pieces.join(" | ");
            el.hidden = false;
          } catch (_err) {
            el.remove();
          }
        }

        async function fetchJsonWithTimeout(url) {
          const controller = new AbortController();
          const timer = window.setTimeout(() => controller.abort(), 3500);
          try {
            const response = await fetch(url, { signal: controller.signal });
            if (!response.ok) {
              throw new Error(`HTTP ${response.status}`);
            }
            return response.json();
          } finally {
            window.clearTimeout(timer);
          }
        }

        function normalizeText(value) {
          return value == null ? "" : String(value).trim();
        }

        function weatherCodeToLabel(code) {
          if (!Number.isFinite(code)) {
            return "";
          }
          if (code === 0) {
            return "Clear";
          }
          if (code === 1 || code === 2) {
            return "Partly Cloudy";
          }
          if (code === 3) {
            return "Cloudy";
          }
          if (code === 45 || code === 48) {
            return "Fog";
          }
          if (code >= 51 && code <= 67) {
            return "Rain";
          }
          if (code >= 71 && code <= 77) {
            return "Snow";
          }
          if (code >= 80 && code <= 82) {
            return "Showers";
          }
          if (code >= 95 && code <= 99) {
            return "Storm";
          }
          return "Weather";
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f5f6f8;
    --card: #ffffff;
    --line: #e8eaf0;
    --ink: #1f2430;
    --muted: #667085;
    --brand: #ff4d4f;
    --brand-deep: #ef3f43;
    --accent: #ff4d4f;
    --tag-bg: #fff2f2;
    --tag-line: #ffd7d7;
    --tag-ink: #cc3b43;
    --shadow: 0 8px 22px rgba(16, 24, 40, 0.06);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-family: "Noto Sans", "Segoe UI", sans-serif;
  }

  .inner {
    width: min(1240px, 100%);
    margin: 0 auto;
    padding: 0 1rem;
  }

  .hero-header {
    position: relative;
    color: #fff;
    background:
      radial-gradient(1200px 420px at 50% 100%, rgba(66, 139, 255, 0.52) 0%, rgba(9, 17, 44, 0.04) 58%),
      radial-gradient(580px 260px at 50% 94%, rgba(64, 184, 255, 0.3), rgba(26, 35, 67, 0.05) 68%),
      linear-gradient(165deg, #070e29 0%, #0d1f4b 48%, #0f1a3a 100%);
    overflow: hidden;
  }

  .hero-header::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(2px 2px at 20% 28%, rgba(255, 255, 255, 0.5), transparent),
      radial-gradient(1px 1px at 32% 12%, rgba(255, 255, 255, 0.45), transparent),
      radial-gradient(2px 2px at 74% 18%, rgba(255, 255, 255, 0.4), transparent),
      radial-gradient(1px 1px at 86% 42%, rgba(255, 255, 255, 0.35), transparent);
    pointer-events: none;
    opacity: 0.7;
  }

  .utility-row {
    position: relative;
    z-index: 2;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .utility-inner {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .utility-links,
  .utility-right {
    display: inline-flex;
    align-items: center;
    gap: 0.82rem;
  }

  .utility-links a,
  .utility-nav a,
  .utility-login {
    text-decoration: none;
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.76rem;
  }

  .utility-links a:hover,
  .utility-nav a:hover {
    color: #fff;
  }

  .utility-weather {
    font-size: 0.76rem;
    color: rgba(235, 240, 255, 0.9);
  }

  .utility-nav {
    display: inline-flex;
    gap: 0.35rem;
  }

  .utility-nav a {
    padding: 0.28rem 0.52rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .utility-nav a.active {
    background: rgba(255, 77, 79, 0.2);
    color: #fff;
  }

  .utility-login {
    background: var(--brand);
    color: #fff;
    border-radius: 6px;
    padding: 0.36rem 0.62rem;
    font-weight: 700;
  }

  .hero-core {
    position: relative;
    z-index: 2;
    padding: 2.3rem 0 2.7rem;
  }

  .hero-inner {
    display: grid;
    justify-items: center;
    gap: 1.1rem;
  }

  .hero-brand {
    text-decoration: none;
    color: #fff;
    display: grid;
    justify-items: center;
    gap: 0.16rem;
  }

  .hero-brand strong {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.01em;
    text-shadow: 0 8px 30px rgba(0, 0, 0, 0.32);
  }

  .hero-brand small {
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(226, 235, 255, 0.9);
  }

  .global-search {
    width: min(680px, 100%);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.45rem;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(220, 229, 242, 0.65);
    border-radius: 10px;
    padding: 0.45rem 0.55rem;
    box-shadow: 0 14px 40px rgba(5, 12, 33, 0.34);
  }

  .search-input {
    border: none;
    background: transparent;
    font: inherit;
    color: #1e293b;
    font-size: 1.02rem;
    padding: 0.26rem 0.18rem;
  }

  .search-input:focus {
    outline: none;
  }

  .search-toggle {
    width: 38px;
    height: 38px;
    border: none;
    border-radius: 999px;
    background: #fff;
    color: var(--brand);
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .search-toggle svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .channel-row {
    background: #fff;
    border-bottom: 1px solid var(--line);
  }

  .channel-inner {
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem;
  }

  .channel-list {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    overflow-x: auto;
    white-space: nowrap;
  }

  .channel-link {
    position: relative;
    text-decoration: none;
    color: #4b5565;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
    padding: 0.24rem 0;
    transition: color 140ms ease;
  }

  .channel-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.78rem;
    height: 3px;
    border-radius: 3px;
    background: var(--brand);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .channel-link:hover,
  .channel-link.active {
    color: var(--brand);
  }

  .channel-link.active::after {
    transform: scaleX(1);
  }

  .channel-cta {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.86rem;
    color: #8a93a5;
  }

  .channel-cta a {
    text-decoration: none;
    background: var(--brand);
    color: #fff;
    border-radius: 6px;
    padding: 0.34rem 0.62rem;
    font-weight: 700;
    font-size: 0.78rem;
  }

  .page-shell {
    padding-top: 1rem;
    padding-bottom: 1.8rem;
    animation: page-in 260ms ease both;
  }

  .panel {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--card);
    box-shadow: var(--shadow);
    padding: 0.95rem;
  }

  .panel + .panel {
    margin-top: 0.85rem;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--tag-line);
    background: var(--tag-bg);
    color: var(--tag-ink);
    font-size: 0.72rem;
    border-radius: 999px;
    padding: 0.18rem 0.48rem;
  }

  .message {
    margin: 0;
    padding: 0.52rem 0.66rem;
    border-radius: 8px;
    font-size: 0.82rem;
    border: 1px solid transparent;
  }

  .message.ok {
    background: #ecfdf3;
    color: #106a44;
    border-color: #c8edd7;
  }

  .message.error {
    background: #fef2f2;
    color: #b42318;
    border-color: #fcd3d5;
  }

  .muted {
    color: var(--muted);
  }

  @keyframes page-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 980px) {
    .utility-inner,
    .channel-inner {
      flex-wrap: wrap;
      padding-top: 0.45rem;
      padding-bottom: 0.45rem;
    }

    .channel-cta {
      width: 100%;
      justify-content: flex-end;
    }

    .hero-core {
      padding: 1.8rem 0 2.05rem;
    }
  }

  @media (max-width: 760px) {
    .utility-links {
      display: none;
    }

    .utility-right {
      width: 100%;
      justify-content: space-between;
    }

    .utility-weather {
      display: none;
    }

    .global-search {
      width: 100%;
    }

    .hero-brand strong {
      font-size: 2.1rem;
    }

    .channel-cta {
      display: none;
    }
  }
</style>
