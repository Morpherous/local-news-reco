---
import NewsLayout from "../layouts/NewsLayout.astro";
---

<NewsLayout
  page="home"
  title="Top Stories For You"
  lead="A personalized stream blended from your recent activity and live news sources."
>
  <div class="home-page">
    <section class="home-top">
      <article class="panel headline-panel">
        <div id="home-headline" class="headline-loading">Loading headline...</div>
      </article>
      <aside class="panel trend-panel">
        <div class="panel-title">
          <h2>Trending Now</h2>
          <button id="home-refresh" type="button">Refresh</button>
        </div>
        <ul id="home-trending" class="trend-list"></ul>
      </aside>
    </section>

    <section class="panel">
      <div class="panel-title">
        <h2>Recommended Feed</h2>
        <span class="muted">Keep reading what matters to you.</span>
      </div>
      <div id="home-feed" class="feed-grid"></div>
    </section>
  </div>

  <template id="home-feed-card-template">
    <article class="feed-card">
      <a class="cover-link">
        <img class="cover" alt="" loading="lazy" />
      </a>
      <div class="content">
        <p class="meta"></p>
        <h3 class="title"></h3>
        <p class="summary"></p>
        <div class="tag-list tags"></div>
        <div class="actions">
          <a class="read-btn">Read Full Story</a>
          <button class="icon-action like-btn" data-action="like" type="button" aria-label="Like" title="Like">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 21s-6.7-4.3-9.3-8.1C.9 10.2 1.8 6.6 4.8 5.1c2-1 4.2-.5 5.6 1.1l1.6 1.9 1.6-1.9c1.4-1.6 3.6-2.1 5.6-1.1 3 1.5 3.9 5.1 2.1 7.8C18.7 16.7 12 21 12 21z"
              ></path>
            </svg>
          </button>
          <button class="icon-action share-btn" data-action="share" type="button" aria-label="Share" title="Share">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M14 3h7v7h-2V6.4l-8.3 8.3-1.4-1.4L17.6 5H14V3zM5 5h6v2H7v10h10v-4h2v6H5V5z"
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </article>
  </template>

  <script src="../scripts/home-page.js"></script>
</NewsLayout>

<style is:global>
  .home-page .home-top {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(21rem, 1fr);
    gap: 0.9rem;
    align-items: stretch;
  }

  .home-page .headline-panel {
    height: clamp(25rem, 60vh, 33rem);
    padding: 0.58rem;
    display: grid;
  }

  .home-page .headline {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    min-height: 0;
    height: 100%;
    display: grid;
    align-content: end;
    color: #fff;
    text-decoration: none;
  }

  .home-page .headline::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 24, 44, 0.86), rgba(0, 24, 44, 0.18));
    z-index: 1;
  }

  .home-page .headline img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }

  .home-page .headline-content {
    position: relative;
    z-index: 2;
    padding: 1rem;
    display: grid;
    gap: 0.5rem;
  }

  .home-page .headline-content p {
    margin: 0;
    font-size: 0.78rem;
    opacity: 0.88;
  }

  .home-page .headline-content h2 {
    margin: 0;
    font-family: "Source Serif 4", serif;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    line-height: 1.12;
  }

  .home-page .headline-content span {
    font-size: 0.92rem;
    line-height: 1.5;
    opacity: 0.95;
    max-width: 52ch;
  }

  .home-page .headline-loading {
    display: grid;
    place-items: center;
    color: var(--muted);
    border: 1px dashed var(--line);
    border-radius: 14px;
    min-height: 0;
    height: 100%;
  }

  .home-page .panel-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
  }

  .home-page .panel-title h2 {
    margin: 0;
    font-family: "Source Serif 4", serif;
    font-size: 1.3rem;
  }

  .home-page .panel-title h3 {
    margin: 0;
    font-family: "Source Serif 4", serif;
  }

  .home-page .panel-title button {
    border: 1px solid #d6ddeb;
    background: #fff;
    color: var(--ink);
    border-radius: 999px;
    padding: 0.35rem 0.62rem;
    font-size: 0.76rem;
    cursor: pointer;
  }

  .home-page .trend-panel {
    height: clamp(25rem, 60vh, 33rem);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 0;
  }

  .home-page .trend-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.45rem;
    min-height: 0;
    overflow: auto;
    padding-right: 0.2rem;
  }

  .home-page .trend-list li a {
    text-decoration: none;
    color: inherit;
    border: 1px solid #dde5f0;
    background: var(--card-2);
    border-radius: 10px;
    padding: 0.55rem;
    display: grid;
    gap: 0.22rem;
  }

  .home-page .trend-list p {
    margin: 0;
    font-size: 0.76rem;
    color: var(--muted);
  }

  .home-page .trend-list strong {
    margin: 0;
    font-family: "Source Serif 4", serif;
    font-size: 1rem;
    line-height: 1.25;
  }

  .home-page .feed-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .home-page .feed-card {
    border: 1px solid #dde5f0;
    border-radius: 14px;
    overflow: hidden;
    background: var(--card-2);
    display: grid;
  }

  .home-page .cover-link {
    display: block;
    height: 12rem;
    background: linear-gradient(135deg, #bad7ea, #f6c7b3);
  }

  .home-page .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .home-page .content {
    padding: 0.7rem;
    display: grid;
    gap: 0.45rem;
  }

  .home-page .content .meta {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .home-page .content .title {
    margin: 0;
    font-family: "Source Serif 4", serif;
    font-size: 1.2rem;
    line-height: 1.22;
  }

  .home-page .content .summary {
    margin: 0;
    color: #334e68;
    line-height: 1.48;
    font-size: 0.92rem;
  }

  .home-page .actions {
    margin-top: 0.22rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .home-page .actions a {
    border: 1px solid #d8e1ef;
    background: #fff;
    border-radius: 999px;
    padding: 0.32rem 0.64rem;
    font-size: 0.74rem;
    text-decoration: none;
    color: var(--ink);
    cursor: pointer;
  }

  .home-page .actions .icon-action {
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #d8e1ef;
    background: #fff;
    color: #667085;
    border-radius: 999px;
    cursor: pointer;
    transition: transform 120ms ease, color 130ms ease, background 130ms ease, border-color 130ms ease;
  }

  .home-page .actions .icon-action svg {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .home-page .actions .icon-action:hover {
    transform: translateY(-1px);
  }

  .home-page .actions .like-btn.is-active {
    border-color: #ffc8cc;
    background: #fff0f1;
    color: #d9363e;
  }

  .home-page .actions .share-btn.is-active {
    border-color: #cbe0ff;
    background: #edf4ff;
    color: #175cd3;
  }

  .home-page .actions .icon-action.is-failed {
    animation: pulse-fail 300ms ease;
  }

  @keyframes pulse-fail {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(0.9);
    }
    100% {
      transform: scale(1);
    }
  }

  @media (max-width: 980px) {
    .home-page .home-top,
    .home-page .feed-grid {
      grid-template-columns: 1fr;
    }

    .home-page .headline-panel,
    .home-page .trend-panel {
      height: auto;
    }

    .home-page .headline {
      min-height: 20rem;
    }

    .home-page .trend-list {
      overflow: visible;
      padding-right: 0;
    }
  }
</style>
