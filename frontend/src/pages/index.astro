---
import NewsLayout from "../layouts/NewsLayout.astro";
---

<NewsLayout
  page="home"
  title="DailyPulse"
  lead="Realtime recommendations powered by your behavior and live news feeds."
>
  <div class="home-page">
    <div class="tt-grid">
      <section class="tt-main">
        <article class="panel brief-panel">
          <div class="brief-head">
            <h2>Today Brief</h2>
            <p id="home-brief-date"></p>
          </div>
          <ul id="home-brief-list" class="brief-list"></ul>
        </article>

        <article class="panel lead-panel">
          <div id="home-headline" class="headline-loading">Loading top story...</div>
        </article>

        <section class="panel stream-panel">
          <div class="panel-title">
            <h2>News Stream</h2>
          </div>
          <div id="home-feed" class="stream-list"></div>
        </section>
      </section>

      <aside class="tt-side">
        <section class="panel rank-panel">
          <div class="panel-title">
            <h2>Live Hot Ranking</h2>
            <button id="home-refresh" type="button">Refresh</button>
          </div>
          <ol id="home-trending" class="rank-list"></ol>
        </section>

        <section class="panel user-panel">
          <h3>Sign in to personalize deeper</h3>
          <p>Track your favorite topics and receive smarter recommendations all day.</p>
          <a href="/insights" class="panel-cta">Open My Feed</a>
        </section>
      </aside>
    </div>
  </div>

  <template id="home-feed-card-template">
    <article class="feed-card">
      <a class="cover-link">
        <img class="cover" alt="" loading="lazy" />
      </a>
      <div class="content">
        <p class="meta"></p>
        <h3 class="title"></h3>
        <p class="summary"></p>
        <div class="tag-list tags" hidden></div>
        <div class="actions">
          <a class="read-btn">Read Full Story</a>
          <button class="icon-action like-btn" data-action="like" type="button" aria-label="Like" title="Like">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 21s-6.7-4.3-9.3-8.1C.9 10.2 1.8 6.6 4.8 5.1c2-1 4.2-.5 5.6 1.1l1.6 1.9 1.6-1.9c1.4-1.6 3.6-2.1 5.6-1.1 3 1.5 3.9 5.1 2.1 7.8C18.7 16.7 12 21 12 21z"
              ></path>
            </svg>
          </button>
          <button class="icon-action share-btn" data-action="share" type="button" aria-label="Share" title="Share">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M14 3h7v7h-2V6.4l-8.3 8.3-1.4-1.4L17.6 5H14V3zM5 5h6v2H7v10h10v-4h2v6H5V5z"
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </article>
  </template>

  <script src="../scripts/home-page.js"></script>
</NewsLayout>

<style is:global>
  .home-page .tt-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
    gap: 1rem;
  }

  .home-page .tt-main {
    display: grid;
    gap: 1rem;
  }

  .home-page .brief-panel {
    background: #fcfcfe;
  }

  .home-page .brief-head {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-bottom: 0.45rem;
  }

  .home-page .brief-head h2 {
    margin: 0;
    font-family: "Source Serif 4", serif;
    font-size: 1.28rem;
    color: #111827;
  }

  .home-page .brief-head p {
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .home-page .brief-list {
    margin: 0;
    padding: 0 0 0 1.15rem;
    display: grid;
    gap: 0.46rem;
  }

  .home-page .brief-list li {
    color: #253041;
    line-height: 1.45;
    font-size: 0.96rem;
  }

  .home-page .lead-panel {
    padding: 0.55rem;
  }

  .home-page .headline {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    min-height: 25rem;
    display: grid;
    align-content: end;
    text-decoration: none;
    color: #fff;
  }

  .home-page .headline::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(5, 12, 30, 0.86), rgba(5, 12, 30, 0.2));
    z-index: 1;
  }

  .home-page .headline img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }

  .home-page .headline-content {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.45rem;
    padding: 1.1rem;
  }

  .home-page .headline-content p {
    margin: 0;
    font-size: 0.86rem;
    opacity: 0.9;
  }

  .home-page .headline-content h2 {
    margin: 0;
    font-family: "Source Serif 4", serif;
    font-size: clamp(1.85rem, 3.1vw, 2.65rem);
    line-height: 1.07;
    max-width: 22ch;
  }

  .home-page .headline-content span {
    font-size: 1.02rem;
    line-height: 1.46;
    max-width: 66ch;
    opacity: 0.96;
  }

  .home-page .headline-loading {
    min-height: 25rem;
    display: grid;
    place-items: center;
    border: 1px dashed var(--line);
    border-radius: 12px;
    color: var(--muted);
  }

  .home-page .stream-panel {
    background: #fff;
  }

  .home-page .panel-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.7rem;
  }

  .home-page .panel-title h2 {
    margin: 0;
    font-family: "Source Serif 4", serif;
    font-size: 1.42rem;
  }

  .home-page .panel-title button {
    border: 1px solid #d3dbe7;
    background: #fff;
    color: #344054;
    border-radius: 999px;
    padding: 0.34rem 0.62rem;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .home-page .stream-list {
    display: grid;
    gap: 0.72rem;
  }

  .home-page .feed-card {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 0.8rem;
    border: 1px solid #e4e8ef;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
  }

  .home-page .cover-link {
    display: block;
    min-height: 150px;
    background: linear-gradient(135deg, #bedaf1, #f9d0be);
  }

  .home-page .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .home-page .content {
    padding: 0.62rem 0.72rem 0.62rem 0;
    display: grid;
    gap: 0.38rem;
  }

  .home-page .content .meta {
    margin: 0;
    font-size: 0.76rem;
    color: #7c8598;
  }

  .home-page .content .title {
    margin: 0;
    font-family: "Source Serif 4", serif;
    font-size: 1.34rem;
    line-height: 1.2;
  }

  .home-page .content .summary {
    margin: 0;
    color: #3a4a66;
    line-height: 1.5;
    font-size: 0.94rem;
  }

  .home-page .actions {
    margin-top: 0.08rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.34rem;
  }

  .home-page .actions .read-btn {
    border: 1px solid #d6deea;
    background: #fff;
    border-radius: 999px;
    padding: 0.3rem 0.62rem;
    font-size: 0.74rem;
    text-decoration: none;
    color: #22314c;
    cursor: pointer;
  }

  .home-page .actions .icon-action {
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #d8e1ef;
    background: #fff;
    color: #667085;
    border-radius: 999px;
    cursor: pointer;
    transition: transform 120ms ease, color 130ms ease, background 130ms ease, border-color 130ms ease;
  }

  .home-page .actions .icon-action svg {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .home-page .actions .icon-action:hover {
    transform: translateY(-1px);
  }

  .home-page .actions .like-btn.is-active {
    border-color: #ffc8cc;
    background: #fff0f1;
    color: #d9363e;
  }

  .home-page .actions .share-btn.is-active {
    border-color: #cbe0ff;
    background: #edf4ff;
    color: #175cd3;
  }

  .home-page .actions .icon-action.is-failed {
    animation: pulse-fail 300ms ease;
  }

  .home-page .tt-side {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .home-page .rank-list {
    counter-reset: rank;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.1rem;
  }

  .home-page .rank-list li {
    counter-increment: rank;
    border-bottom: 1px solid #edf1f6;
    padding: 0.55rem 0;
  }

  .home-page .rank-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .home-page .rank-list li a {
    text-decoration: none;
    color: inherit;
    display: grid;
    gap: 0.16rem;
    position: relative;
    padding-left: 1.5rem;
  }

  .home-page .rank-list li a::before {
    content: counter(rank);
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 800;
    color: #ff4d4f;
    font-size: 1rem;
    line-height: 1;
  }

  .home-page .rank-list li p {
    margin: 0;
    font-size: 0.74rem;
    color: #8a93a5;
  }

  .home-page .rank-list li strong {
    margin: 0;
    font-size: 1rem;
    line-height: 1.34;
    color: #212b3b;
  }

  .home-page .user-panel h3 {
    margin: 0;
    font-family: "Source Serif 4", serif;
    font-size: 1.22rem;
  }

  .home-page .user-panel p {
    margin: 0.48rem 0 0;
    color: #637089;
    line-height: 1.5;
    font-size: 0.9rem;
  }

  .home-page .panel-cta {
    margin-top: 0.75rem;
    display: inline-flex;
    text-decoration: none;
    color: #fff;
    background: var(--brand);
    border-radius: 7px;
    padding: 0.48rem 0.76rem;
    font-size: 0.82rem;
    font-weight: 700;
  }

  @keyframes pulse-fail {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(0.9);
    }
    100% {
      transform: scale(1);
    }
  }

  @media (max-width: 1080px) {
    .home-page .tt-grid {
      grid-template-columns: 1fr;
    }

    .home-page .tt-side {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 820px) {
    .home-page .feed-card {
      grid-template-columns: 1fr;
    }

    .home-page .cover-link {
      min-height: 11rem;
    }

    .home-page .content {
      padding: 0.62rem;
    }

    .home-page .headline,
    .home-page .headline-loading {
      min-height: 19rem;
    }

    .home-page .tt-side {
      grid-template-columns: 1fr;
    }
  }
</style>
