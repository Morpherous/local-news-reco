---
import NewsLayout from "../layouts/NewsLayout.astro";
---

<NewsLayout
  page="home"
  title="Search Results"
  lead="Search results"
>
  <div class="search-page">
    <section class="panel search-summary">
      <h1>Search Results</h1>
      <p id="search-query-line" class="muted"></p>
    </section>

    <section class="panel">
      <div id="search-results" class="result-list"></div>
    </section>
  </div>

  <template id="search-card-template">
    <article class="result-card">
      <a class="cover-link">
        <img class="cover" alt="" loading="lazy" />
      </a>
      <div class="content">
        <p class="meta"></p>
        <h2 class="title"></h2>
        <p class="summary"></p>
        <div class="actions">
          <a class="read-btn">Read Full Story</a>
          <button class="icon-action like-btn" data-action="like" type="button" aria-label="Like" title="Like">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 21s-6.7-4.3-9.3-8.1C.9 10.2 1.8 6.6 4.8 5.1c2-1 4.2-.5 5.6 1.1l1.6 1.9 1.6-1.9c1.4-1.6 3.6-2.1 5.6-1.1 3 1.5 3.9 5.1 2.1 7.8C18.7 16.7 12 21 12 21z"
              ></path>
            </svg>
          </button>
          <button class="icon-action share-btn" data-action="share" type="button" aria-label="Share" title="Share">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M14 3h7v7h-2V6.4l-8.3 8.3-1.4-1.4L17.6 5H14V3zM5 5h6v2H7v10h10v-4h2v6H5V5z"
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </article>
  </template>

  <script src="../scripts/search-page.js"></script>
</NewsLayout>

<style is:global>
  .search-page {
    display: grid;
    gap: 0.9rem;
  }

  .search-summary h1 {
    margin: 0;
    font-family: "Source Serif 4", serif;
    font-size: 1.8rem;
    line-height: 1.1;
  }

  .search-summary p {
    margin: 0.35rem 0 0;
    font-size: 0.92rem;
  }

  .result-list {
    display: grid;
    gap: 0.72rem;
  }

  .result-card {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 0.78rem;
    border: 1px solid #e3e8f0;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
  }

  .result-card .cover-link {
    display: block;
    min-height: 160px;
    background: linear-gradient(135deg, #c5dcf1, #f8d2c1);
  }

  .result-card .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .result-card .content {
    padding: 0.66rem 0.76rem 0.66rem 0;
    display: grid;
    gap: 0.4rem;
  }

  .result-card .meta {
    margin: 0;
    font-size: 0.76rem;
    color: #7b8698;
  }

  .result-card .title {
    margin: 0;
    font-family: "Source Serif 4", serif;
    font-size: 1.36rem;
    line-height: 1.2;
    color: #1f2a3d;
  }

  .result-card .summary {
    margin: 0;
    color: #3b4c67;
    line-height: 1.5;
    font-size: 0.95rem;
  }

  .result-card .actions {
    margin-top: 0.1rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .result-card .read-btn {
    border: 1px solid #d6deea;
    background: #fff;
    border-radius: 999px;
    padding: 0.3rem 0.62rem;
    font-size: 0.74rem;
    text-decoration: none;
    color: #22314c;
    cursor: pointer;
  }

  .result-card .icon-action {
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #d8e1ef;
    background: #fff;
    color: #667085;
    border-radius: 999px;
    cursor: pointer;
    transition: transform 120ms ease, color 130ms ease, background 130ms ease, border-color 130ms ease;
  }

  .result-card .icon-action svg {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .result-card .icon-action:hover {
    transform: translateY(-1px);
  }

  .result-card .like-btn.is-active {
    border-color: #ffc8cc;
    background: #fff0f1;
    color: #d9363e;
  }

  .result-card .share-btn.is-active {
    border-color: #cbe0ff;
    background: #edf4ff;
    color: #175cd3;
  }

  .result-card .icon-action.is-failed {
    animation: pulse-fail 300ms ease;
  }

  @keyframes pulse-fail {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(0.9);
    }
    100% {
      transform: scale(1);
    }
  }

  @media (max-width: 880px) {
    .result-card {
      grid-template-columns: 1fr;
    }

    .result-card .cover-link {
      min-height: 11rem;
    }

    .result-card .content {
      padding: 0.66rem;
    }
  }
</style>
