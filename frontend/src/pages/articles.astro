---
import NewsLayout from "../layouts/NewsLayout.astro";
---

<NewsLayout
  page="home"
  title="Explore Moved"
  lead="Explore has been merged into Home with channel tabs and search."
>
  <section class="panel explore-moved">
    <h2>Explore has moved to Home</h2>
    <p>Use the Home page search box and channel tabs to discover stories faster.</p>
    <a href="/" class="back-home">Go to Home</a>
  </section>
  <script is:inline>
    if (typeof window !== "undefined") {
      window.location.replace("/");
    }
  </script>
</NewsLayout>

<style is:global>
  .explore-moved {
    display: grid;
    gap: 0.5rem;
  }

  .explore-moved h2 {
    margin: 0;
    font-family: "Source Serif 4", serif;
    font-size: 1.5rem;
  }

  .explore-moved p {
    margin: 0;
    color: var(--muted);
    max-width: 64ch;
  }

  .explore-moved .back-home {
    margin-top: 0.25rem;
    width: fit-content;
    text-decoration: none;
    color: #fff;
    background: var(--brand);
    border-radius: 999px;
    padding: 0.38rem 0.74rem;
    font-size: 0.82rem;
    font-weight: 600;
  }
</style>
